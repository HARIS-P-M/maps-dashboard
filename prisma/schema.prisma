// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  authUserId String   @unique
  email     String   @unique
  name      String
  role      Role     @default(STUDENT)
  status    UserStatus @default(ACTIVE)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stats         UserStats?
  targetProfile TargetProfile?
  resumes       Resume[]
  resumeAnalyses ResumeAnalysis[]
  codingAttempts CodingAttempt[]
  aptitudeAttempts AptitudeAttempt[]
  interviewSessions InterviewSession[]
  agentSessions AgentSession[]
  roadmapItems  RoadmapItem[]
  notifications Notification[]
  leaderboard   Leaderboard?
  auditLogs     AdminAuditLog[] @relation("AdminAuditActor")
  updatedSettings SystemSetting[] @relation("SettingUpdater")
  announcements Announcement[] @relation("AnnouncementAuthor")
  agentConfigs  AgentConfig[] @relation("AgentConfigUpdater")

  @@map("users")
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ─── User Stats ───────────────────────────────────────────────────────────────

model UserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique
  placementProb      Float    @default(0)
  atsScore           Int      @default(0)
  interviewReadiness Float    @default(0)
  streak             Int      @default(0)
  longestStreak      Int      @default(0)
  problemsSolved     Int      @default(0)
  accuracy           Float    @default(0)
  mockInterviews     Int      @default(0)
  activeDays         Int      @default(0)
  xp                 Int      @default(0)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model TargetProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  targetRole         String
  targetCompany      String?
  graduationYear     Int?
  branch             String?
  degree             String?
  availableMinutes   Int?
  targetPlacementDate DateTime?
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("target_profiles")
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  originalFilename String
  extractedText  String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses ResumeAnalysis[]

  @@index([userId, createdAt])
  @@map("resumes")
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  userId          String
  resumeId        String?
  overallScore    Int
  jdMatchScore    Int?
  sectionScores   Json
  keywordGaps     Json
  atsFixes        Json
  rewrittenBullets Json?
  summary         String   @db.Text
  model            String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("resume_analyses")
}

model CodingAttempt {
  id             String   @id @default(cuid())
  userId         String
  problemId      String?
  problemTitle   String?
  language       String
  submittedCode  String   @db.Text
  passed         Boolean
  timeComplexity String?
  spaceComplexity String?
  feedback       String?  @db.Text
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coding_attempts")
}

model AptitudeAttempt {
  id            String   @id @default(cuid())
  userId        String
  topic         String
  difficulty    String?
  correct       Boolean
  responseTimeMs Int?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic, createdAt])
  @@map("aptitude_attempts")
}

model InterviewSession {
  id          String   @id @default(cuid())
  userId      String
  role        String?
  company     String?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations InterviewEvaluation[]

  @@index([userId, startedAt])
  @@map("interview_sessions")
}

model InterviewEvaluation {
  id              String   @id @default(cuid())
  sessionId       String
  question        String   @db.Text
  answer          String   @db.Text
  starScore       Float?
  clarity         Float?
  confidence      Float?
  relevance       Float?
  overallScore    Float?
  feedback        String?  @db.Text
  createdAt       DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("interview_evaluations")
}

// ─── Agent Sessions ───────────────────────────────────────────────────────────

model AgentSession {
  id        String    @id @default(cuid())
  userId    String
  agentName AgentName
  input     String    @db.Text
  output    String    @db.Text
  metadata  Json?     // extra data: scores, parsed results, etc.
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentName])
  @@map("agent_sessions")
}

enum AgentName {
  ORCHESTRATOR
  RESUME
  CODING
  APTITUDE
  INTERVIEW
  COMPANY
  COACH
  QUESTION_GENERATOR
  PROBLEM_GENERATOR
}

// ─── Roadmap ──────────────────────────────────────────────────────────────────

model RoadmapItem {
  id        String   @id @default(cuid())
  userId    String
  phase     String
  title     String
  week      String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("roadmap_items")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  agentName String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  NUDGE
  WARNING
  SUCCESS
  INFO
}

// ─── Leaderboard ─────────────────────────────────────────────────────────────

model Leaderboard {
  id        String   @id @default(cuid())
  userId    String   @unique
  xp        Int      @default(0)
  rank      Int      @default(0)
  streak    Int      @default(0)
  delta     Int      @default(0) // rank change since last update
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaderboard")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String
  updatedAt DateTime @updatedAt

  updater User @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

model Announcement {
  id        String   @id @default(cuid())
  message   String   @db.Text
  audience  AnnouncementAudience @default(ALL_STUDENTS)
  createdBy String
  publishedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  author User @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([audience, publishedAt])
  @@map("announcements")
}

enum AnnouncementAudience {
  ALL_STUDENTS
  ACTIVE_STUDENTS
  ADMINS
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminUserId String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model AgentConfig {
  id          String    @id @default(cuid())
  agentName   AgentName @unique
  enabled     Boolean   @default(true)
  model       String
  temperature Float     @default(0.2)
  maxTokens   Int       @default(4096)
  updatedBy   String
  updatedAt   DateTime  @updatedAt

  updater User @relation("AgentConfigUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("agent_configs")
}
