// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(STUDENT)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stats         UserStats?
  agentSessions AgentSession[]
  roadmapItems  RoadmapItem[]
  notifications Notification[]
  leaderboard   Leaderboard?

  @@map("users")
}

enum Role {
  STUDENT
  ADMIN
}

// ─── User Stats ───────────────────────────────────────────────────────────────

model UserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique
  placementProb      Float    @default(50)
  atsScore           Int      @default(60)
  interviewReadiness Float    @default(50)
  streak             Int      @default(0)
  longestStreak      Int      @default(0)
  problemsSolved     Int      @default(0)
  accuracy           Float    @default(70)
  mockInterviews     Int      @default(0)
  activeDays         Int      @default(0)
  xp                 Int      @default(0)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ─── Agent Sessions ───────────────────────────────────────────────────────────

model AgentSession {
  id        String    @id @default(cuid())
  userId    String
  agentName AgentName
  input     String    @db.Text
  output    String    @db.Text
  metadata  Json?     // extra data: scores, parsed results, etc.
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentName])
  @@map("agent_sessions")
}

enum AgentName {
  ORCHESTRATOR
  RESUME
  CODING
  INTERVIEW
  COMPANY
  COACH
}

// ─── Roadmap ──────────────────────────────────────────────────────────────────

model RoadmapItem {
  id        String   @id @default(cuid())
  userId    String
  phase     String
  title     String
  week      String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("roadmap_items")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  agentName String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  NUDGE
  WARNING
  SUCCESS
  INFO
}

// ─── Leaderboard ─────────────────────────────────────────────────────────────

model Leaderboard {
  id        String   @id @default(cuid())
  userId    String   @unique
  xp        Int      @default(0)
  rank      Int      @default(0)
  streak    Int      @default(0)
  delta     Int      @default(0) // rank change since last update
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaderboard")
}
