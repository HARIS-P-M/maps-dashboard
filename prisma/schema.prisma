// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(STUDENT)
  status    UserStatus @default(ACTIVE)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stats         UserStats?
  agentSessions AgentSession[]
  roadmapItems  RoadmapItem[]
  notifications Notification[]
  leaderboard   Leaderboard?
  auditLogs     AdminAuditLog[] @relation("AdminAuditActor")
  updatedSettings SystemSetting[] @relation("SettingUpdater")
  announcements Announcement[] @relation("AnnouncementAuthor")
  agentConfigs  AgentConfig[] @relation("AgentConfigUpdater")

  @@map("users")
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ─── User Stats ───────────────────────────────────────────────────────────────

model UserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique
  placementProb      Float    @default(0)
  atsScore           Int      @default(0)
  interviewReadiness Float    @default(0)
  streak             Int      @default(0)
  longestStreak      Int      @default(0)
  problemsSolved     Int      @default(0)
  accuracy           Float    @default(0)
  mockInterviews     Int      @default(0)
  activeDays         Int      @default(0)
  xp                 Int      @default(0)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ─── Agent Sessions ───────────────────────────────────────────────────────────

model AgentSession {
  id        String    @id @default(cuid())
  userId    String
  agentName AgentName
  input     String    @db.Text
  output    String    @db.Text
  metadata  Json?     // extra data: scores, parsed results, etc.
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentName])
  @@map("agent_sessions")
}

enum AgentName {
  ORCHESTRATOR
  RESUME
  CODING
  APTITUDE
  INTERVIEW
  COMPANY
  COACH
  QUESTION_GENERATOR
  PROBLEM_GENERATOR
}

// ─── Roadmap ──────────────────────────────────────────────────────────────────

model RoadmapItem {
  id        String   @id @default(cuid())
  userId    String
  phase     String
  title     String
  week      String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("roadmap_items")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  agentName String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  NUDGE
  WARNING
  SUCCESS
  INFO
}

// ─── Leaderboard ─────────────────────────────────────────────────────────────

model Leaderboard {
  id        String   @id @default(cuid())
  userId    String   @unique
  xp        Int      @default(0)
  rank      Int      @default(0)
  streak    Int      @default(0)
  delta     Int      @default(0) // rank change since last update
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaderboard")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String
  updatedAt DateTime @updatedAt

  updater User @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

model Announcement {
  id        String   @id @default(cuid())
  message   String   @db.Text
  audience  AnnouncementAudience @default(ALL_STUDENTS)
  createdBy String
  publishedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  author User @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([audience, publishedAt])
  @@map("announcements")
}

enum AnnouncementAudience {
  ALL_STUDENTS
  ACTIVE_STUDENTS
  ADMINS
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminUserId String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model AgentConfig {
  id          String    @id @default(cuid())
  agentName   AgentName @unique
  enabled     Boolean   @default(true)
  model       String
  temperature Float     @default(0.2)
  maxTokens   Int       @default(4096)
  updatedBy   String
  updatedAt   DateTime  @updatedAt

  updater User @relation("AgentConfigUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("agent_configs")
}
